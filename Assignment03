n = int(input("Enter a number: "))

if n % 2 == 0:
    print("Number is Even")
else:
    print("Number is Odd")

if n > 1:
    prime = True

    for i in range(2, n):
        if n % i == 0:
            prime = False
            break

    if prime:
        print("Number is Prime")
    else:
        print("Number is Not Prime")
else:
    print("Number is Not Prime")
